# vLLM endpoint (correct already)
OPENAI_API_BASE=http://localhost:8000/v1
OPENAI_API_KEY=vllm

# ⚠️ IMPORTANT: must match --served-model-name
INDEXER_MODEL=openai/qwen_35b_agent

# Repo path
PAGEINDEX_DIR=./PageIndex

# Upload
MAX_UPLOAD_MB=100

# FastAPI service
HOST=0.0.0.0
PORT=8080

# Workspace for persisting indexed documents
WORKSPACE_DIR=./workspace
